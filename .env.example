# ==============================================================================
# PhySpace-Forge v0.1.0 Environment Configuration (.env.example)
# Copy this file to `.env` if you wish to connect a custom LLM/VLM endpoint.
# By default (without `.env`), PhySpace-Forge runs 100% out-of-the-box using its
# calibrated Built-in 20+ Material Constitutive Knowledge Bank (`builtin_offline`).
# ==============================================================================

# 1. Constitutive Inference Mode:
#    - "builtin_offline" : (Default) Zero-config offline 20+ material knowledge bank
#    - "remote_llm"      : Query the OpenAI-compatible Chat Completions endpoint below
#    - "auto"            : Try remote LLM first, automatically fall back to built-in bank
PHYSPACE_LLM_MODE=builtin_offline

# 2. OpenAI-Compatible Chat Completions Endpoint URL:
#    - Local Ollama      : http://127.0.0.1:11434/v1/chat/completions
#    - Local vLLM/SGLang : http://127.0.0.1:8000/v1/chat/completions
#    - Qwen / DashScope  : https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
#    - DeepSeek API      : https://api.deepseek.com/v1/chat/completions
#    - OpenAI API        : https://api.openai.com/v1/chat/completions
PHYSPACE_LLM_API_URL=http://127.0.0.1:11434/v1/chat/completions

# 3. Model Name:
#    - Examples: qwen2.5:14b | Qwen/Qwen2.5-VL-72B-Instruct | qwen-plus | deepseek-chat | gpt-4o
PHYSPACE_LLM_MODEL=qwen2.5:14b

# 4. API Key (Leave empty for unauthenticated local Ollama/vLLM):
PHYSPACE_LLM_API_KEY=
